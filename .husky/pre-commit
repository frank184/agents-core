#!/usr/bin/env sh

# Pre-commit hook for linting staged TypeScript files
# Get staged TS files from the repo (including .ts and .tsx)
STAGED_TS_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(ts|tsx)$' | grep '^slack-agent/')

if [ -z "$STAGED_TS_FILES" ]; then
  exit 0
fi

echo "🔍 Running ESLint on staged TypeScript files..."

# Run ESLint from slack-agent directory with relative paths
cd slack-agent 2>/dev/null || exit 0

for FILE in $STAGED_TS_FILES; do
  # Remove slack-agent/ prefix for relative path
  RELATIVE_FILE="${FILE#slack-agent/}"
  npx eslint "$RELATIVE_FILE"
  if [ $? -ne 0 ]; then
    echo ""
    echo "❌ ESLint errors found. Options:"
    echo "   1. Fix errors manually"
    echo "   2. Run: npm run format (to auto-fix formatting)"
    echo "   3. Run: npm run lint   (to see all issues)"
    exit 1
  fi
done

echo "✅ ESLint passed"
exit 0
