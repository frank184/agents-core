{
    "name": "slack-documentation-agent",
    "version": "1.0.0",
    "description": "Slack bot for parsing and generating project documentation",
    "main": "dist/index.js",
    "scripts": {
        "dev": "ts-node src/index.ts",
        "build": "tsc && tsc --project tsconfig.test.json",
        "start": "node dist/index.js",
        "test": "tsx --test tests/**/*.test.ts",
        "test:watch": "tsx --test --watch tests/**/*.test.ts",
        "test:coverage": "tsx --test --experimental-test-coverage tests/**/*.test.ts",
        "type-check": "tsc --noEmit && tsc --project tsconfig.test.json",
        "lint": "eslint src/**/*.ts",
        "format": "prettier --write src/**/*.ts",
        "changelog": "git-cliff --output CHANGELOG.md",
        "changelog:preview": "git-cliff --unreleased",
        "changelog:init": "git-cliff --init",
        "release": "standard-version",
        "release:minor": "standard-version --release-as minor",
        "release:major": "standard-version --release-as major",
        "release:patch": "standard-version --release-as patch",
        "release:dry": "standard-version --dry-run",
        "prepare": "cd $(git rev-parse --show-toplevel) && git config core.hooksPath .husky"
    },
    "dependencies": {
        "@github/copilot-sdk": "^0.1.30",
        "@slack/bolt": "^3.16.0",
        "@types/node": "^20.0.0",
        "axios": "^1.6.0",
        "dotenv": "^16.0.0",
        "typescript": "^5.0.0"
    },
    "devDependencies": {
        "@commitlint/cli": "^18.4.0",
        "@commitlint/config-conventional": "^18.4.0",
        "@eslint/js": "^9.0.0",
        "@types/eslint": "^9.0.0",
        "@types/jest": "^29.0.0",
        "@typescript-eslint/eslint-plugin": "^7.0.0",
        "@typescript-eslint/parser": "^7.0.0",
        "eslint": "^9.0.0",
        "git-cliff": "^2.12.0",
        "husky": "^8.0.3",
        "jest": "^29.0.0",
        "prettier": "^3.0.0",
        "standard-version": "^9.5.0",
        "ts-jest": "^29.0.0",
        "ts-node": "^10.0.0",
        "tsx": "^4.21.0",
        "typescript": "^5.0.0"
    }
}
